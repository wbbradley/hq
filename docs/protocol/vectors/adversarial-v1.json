      "name": "content-closing-brace-missing",
      "class": "malformed-json",
      "base": "canonical-installation-v1",
      "mutation": {
        "op": "replace-once",
        "find": "\"label\":\"alpha\"}}",
        "replacement": "\"label\":\"alpha\"}"
      },
      "outer": "resign-fixture-key",
      "last_state": "CryptographicallyVerifiedEvent",
      "failure": "content-malformed-json"
    },
