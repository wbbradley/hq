[Unit]
Description=HQ local node (domain RPC, SQLite owner, and Nostr transport)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment="PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=REPLACE_WITH_ABSOLUTE_HQ_PATH daemon run
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
