# Canonical quantitative limits for scripts/verify-rust-qualification.sh.
# Values are intentionally generous wall-clock and resident-set ceilings that detect order-of-
# magnitude regressions on supported CI runners without pretending to be microbenchmarks.
HQ_QUALIFICATION_COLD_READINESS_MAX_MILLISECONDS=5000
HQ_QUALIFICATION_FULL_REBUILD_MAX_MILLISECONDS=10000
HQ_QUALIFICATION_LATE_PARENT_FANOUT_MAX_MILLISECONDS=5000
HQ_QUALIFICATION_LATER_PAGE_BATCH_MAX_MILLISECONDS=1000
HQ_QUALIFICATION_INVALIDATION_REDRAW_MAX_MILLISECONDS=100
HQ_QUALIFICATION_MAXIMUM_MARKDOWN_PAGE_REDRAW_MAX_MILLISECONDS=100
HQ_QUALIFICATION_QUEUE_SHUTDOWN_MAX_MILLISECONDS=1000
HQ_QUALIFICATION_IDLE_RESIDENT_MEMORY_MAX_KIBIBYTES=131072
HQ_QUALIFICATION_ACTIVE_RESIDENT_MEMORY_MAX_KIBIBYTES=196608
HQ_QUALIFICATION_RELEASE_BUILD_MAX_SECONDS=900
HQ_QUALIFICATION_GRACEFUL_SHUTDOWN_MAX_MILLISECONDS=5000
